<view class="page"><view class="hero"><text wx:if="{{isDemo}}" class="demo-badge">演示模式</text><view class="hero-title">连续变化排行榜</view><text class="hero-sub">统计日 {{release.statistic_date || '--'}}</text></view>
 <view class="tabs"><view class="tab {{direction==='increase'?'active':''}}" data-value="increase" bindtap="change">连续增加</view><view class="tab {{direction==='decrease'?'active':''}}" data-value="decrease" bindtap="change">连续减少</view></view>
 <view class="notice">{{rule || '份额不变或缺失均中断连续计数；按有效统计日计算。'}}</view><view wx:if="{{error}}" class="notice error">{{error}}<button class="secondary retry" bindtap="load">重试</button></view><view wx:elif="{{loading}}" class="loading">加载中…</view>
 <view wx:elif="{{items.length}}" class="card"><view wx:for="{{items}}" wx:key="code" class="row" data-code="{{item.code}}" bindtap="openDetail"><text class="rank">{{item.rank || index+1}}</text><view class="row-main"><view class="name">{{item.name}}</view><view class="code">{{item.start_date}} 至 {{item.end_date}}</view></view><view class="metrics"><text class="metric-main {{item.tone}}">{{item.days}}日</text><text class="metric-sub">区间 {{item.cumulativeText}}</text></view></view></view><view wx:else class="card empty">数据不足、存在缺失或特殊事件影响，当前不生成连续结论。</view>
</view>

